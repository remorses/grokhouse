{
  // The office page is static assets; the Worker only answers /api/* (Grok Bot proxy).
  "name": "grok-bot-office",
  "compatibility_date": "2026-10-07",
  // request.signal aborts when the page closes /api/watch, so the upstream stream stops too.
  "compatibility_flags": ["enable_request_signal"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
